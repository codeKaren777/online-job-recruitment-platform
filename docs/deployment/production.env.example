# Production reference only. Copy values deliberately into /opt/recruitment/.env.
# Replace all CHANGE_ME values. Never commit the production .env.
COMPOSE_PROJECT_NAME=recruitment

POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=CHANGE_ME_random_database_bootstrap_password
POSTGRES_RUNTIME_USER=recruitment_app
POSTGRES_RUNTIME_PASSWORD=CHANGE_ME_random_database_runtime_password
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=0

JWT_SECRET_BASE64=CHANGE_ME_base64_encoded_32_random_bytes
JWT_ISSUER=groupcc2-recruitment
JWT_AUDIENCE=groupcc2-api

MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_random_minio_root_password
PROFILE_STORAGE_ENABLED=true
PROFILE_STORAGE_ENDPOINT=http://minio:9000
# Must be an HTTPS address reachable by clients for signed document URLs.
PROFILE_STORAGE_PUBLIC_ENDPOINT=https://CHANGE_ME_minio_or_s3_api_hostname
PROFILE_STORAGE_REGION=us-east-1
PROFILE_STORAGE_BUCKET=recruitment-documents
PROFILE_STORAGE_ACCESS_KEY=CHANGE_ME_minio_application_user
PROFILE_STORAGE_SECRET_KEY=CHANGE_ME_random_minio_application_secret
PROFILE_DOWNLOAD_SECONDS=120

APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_MAIL_ENABLED=false
APP_MAIL_FROM=
APP_MAIL_POLL_INTERVAL_MS=30000
PASSWORD_RESET_URL=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
APP_OPENAPI_ENABLED=false
APP_OPENAPI_PUBLIC=false
