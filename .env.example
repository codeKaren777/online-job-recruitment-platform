# Local development uses this existing PostgreSQL account for both Spring Boot
# and Flyway. This account bypasses RLS if it is a PostgreSQL superuser.
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/recruitment
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=groupcc2-recruitment
JWT_AUDIENCE=groupcc2-api
# MinIO setup: docs/minio-setup.md (each local instance has its own bucket/account).
# Admin login for http://localhost:9001; replace locally, never share/commit secrets.
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_NAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ADMIN_PASSWORD

# Leave false until the private bucket and restricted application identity exist.
# true enables the adapter only; it does not make storage or HTTP routes public.
PROFILE_STORAGE_ENABLED=false
# Host JVM endpoint; Docker Compose overrides this to http://minio:9000.
PROFILE_STORAGE_ENDPOINT=http://localhost:9000
# Browser-reachable signed-link hostname. This does NOT make the bucket public.
PROFILE_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
PROFILE_STORAGE_REGION=us-east-1
# Create this private bucket once in each developer's local MinIO instance.
PROFILE_STORAGE_BUCKET=recruitment-documents
# Separate restricted account provisioned with docs/minio-document-policy.json.
# Do not copy MINIO_ROOT_USER/MINIO_ROOT_PASSWORD here.
PROFILE_STORAGE_ACCESS_KEY=REPLACE_WITH_DOCUMENT_SERVICE_ACCESS_KEY
PROFILE_STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_DOCUMENT_SERVICE_SECRET
# Signed GET validity: 30..300 seconds; defaults to two minutes.
PROFILE_DOWNLOAD_SECONDS=120
