# Local development uses this existing PostgreSQL account for both Spring Boot
# and Flyway. This account bypasses RLS if it is a PostgreSQL superuser.
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/recruitment
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=groupcc2-recruitment
JWT_AUDIENCE=groupcc2-api
