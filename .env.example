# Local development uses this existing PostgreSQL account for both Spring Boot
# and Flyway. This account bypasses RLS if it is a PostgreSQL superuser.
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=karen777
# Backend runtime role; keep this separate from the Flyway/bootstrap account.
POSTGRES_RUNTIME_USER=recruitment_app
POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/recruitment
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=groupcc2-recruitment
JWT_AUDIENCE=groupcc2-api
# Optional first-start administrator bootstrap. Set both values only when the
# database has no administrator, then remove them after the first startup.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# MinIO setup: docs/minio-setup.md (each local instance has its own bucket/account).
# Admin login for http://localhost:9001; replace locally, never share/commit secrets.
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_NAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_ADMIN_PASSWORD

# Leave false only when MinIO is intentionally unavailable. Set true after the
# private bucket and restricted application identity are provisioned.
PROFILE_STORAGE_ENABLED=true
# Host JVM endpoint; Docker Compose overrides this to http://minio:9000.
PROFILE_STORAGE_ENDPOINT=http://localhost:9000
# Browser-reachable signed-link hostname. This does NOT make the bucket public.
PROFILE_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
PROFILE_STORAGE_REGION=us-east-1
# Create this private bucket once in each developer's local MinIO instance.
PROFILE_STORAGE_BUCKET=recruitment-documents
# Separate restricted account provisioned with docs/minio-document-policy.json.
# Do not copy MINIO_ROOT_USER/MINIO_ROOT_PASSWORD here.
PROFILE_STORAGE_ACCESS_KEY=REPLACE_WITH_DOCUMENT_SERVICE_ACCESS_KEY
PROFILE_STORAGE_SECRET_KEY=REPLACE_WITH_RANDOM_DOCUMENT_SERVICE_SECRET
# Signed GET validity: 30..300 seconds.
PROFILE_DOWNLOAD_SECONDS=120
PROFILE_PICTURE_MAX_BYTES=5242880

# Email delivery remains disabled until SMTP is configured. Place real values in local .env only.
APP_MAIL_ENABLED=false
APP_MAIL_POLL_INTERVAL_MS=30000
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# Abuse controls use PostgreSQL counters, shared by every application instance.
APP_RATE_LIMIT_ENABLED=true
# The host Nginx is loopback/trusted. Add only verified reverse-proxy CIDRs.
APP_RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1
APP_RATE_LIMIT_LOGIN_REQUESTS=10
APP_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
APP_RATE_LIMIT_REGISTRATION_REQUESTS=5
APP_RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
APP_RATE_LIMIT_RECOVERY_REQUESTS=5
APP_RATE_LIMIT_RECOVERY_WINDOW_SECONDS=3600
APP_RATE_LIMIT_RESET_REQUESTS=10
APP_RATE_LIMIT_RESET_WINDOW_SECONDS=3600
APP_RATE_LIMIT_UPLOAD_REQUESTS=20
APP_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
